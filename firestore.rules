rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Les administrateurs se connectent par identifiant + mot de passe (email interne invisible).
    function signed(){ return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password' && request.auth.token.email.matches('.*@ota-admin[.]example[.]com'); }
    function uname(){ return request.auth.token.email.split('@')[0]; }
    function owner(){ return signed() && uname() == 'natheo'; }
    function admin(){ return owner() || (signed() && exists(/databases/$(db)/documents/admins/$(uname()))); }

    // Équipe : seul le propriétaire gère la liste.
    match /admins/{u} { allow get: if signed() && uname() == u; allow list, write: if owner(); }
    match /adminTokens/{t} { allow read, write: if admin(); }

    // Joueurs : le public peut seulement s'inscrire (statut "pending"), jamais lire.
    match /players/{i} {
      allow create: if request.resource.data.status == 'pending' && request.resource.data.xp == 0 && !('code' in request.resource.data);
      allow read, update, delete: if admin();
    }
    match /codes/{c}    { allow read, write: if admin(); }
    match /keys/{m}     { allow read, write: if admin(); }
    match /members/{c}  { allow get: if true; allow list, write: if admin(); }
    match /board/{b}    { allow read: if true; allow write: if admin(); }
    match /missions/{m} { allow read: if true; allow write: if admin(); }
    match /posters/{p}  { allow read: if true; allow write: if admin(); }
    match /settings/{s} { allow read: if true; allow write: if admin(); }
    match /subs/{s}     { allow create: if request.resource.data.status == 'pending'; allow read, update, delete: if admin(); }
  }
}
